# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Update the following line with your MySQL credentials:
DATABASE_URL="mysql://root:password@127.0.0.1:3306/reliclanka"

# Security
JWT_ACCESS_SECRET="change-this-secret-in-production"
JWT_REFRESH_SECRET="change-this-refresh-secret-in-production"
CORS_ORIGIN="*"

# Storage (local or s3)
STORAGE_PROVIDER="local"

# Email
SMTP_HOST="smtp.example.com"
SMTP_PORT=587
SMTP_USER="user"
SMTP_PASS="pass"
SMTP_FROM="noreply@reliclankatours.com"
